# Leave blank to build from src/data/seed.json. Set both to build from Sanity.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional. Form service endpoint (e.g. Formspree). Blank = Netlify Forms.
PUBLIC_FORM_ENDPOINT=

# Netlify only (not used by the build). Emails each contact-form request via Resend.
# RESEND_API_KEY=
# NOTIFY_EMAIL=        # default: Site settings email in Sanity
# SEND_CONFIRMATION=   # "false" turns off the homeowner confirmation
