---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FixAProblem from '../components/FixAProblem.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import PlanAProject from '../components/PlanAProject.astro';
import Crew from '../components/Crew.astro';
import Review from '../components/Review.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { getSiteContent } from '../lib/content';

const content = await getSiteContent();
const { home } = content;
const project = content.projects.find((p) => p.slug === home.featured.project) ?? content.projects[0];
const review = content.reviews[0];
const homeFaqs = content.faqs.filter((f) => f.home);
---
<Base title={home.seoTitle} description={home.seoDescription}>
  <Hero hero={home.hero} />
  <FixAProblem fix={home.fix} />
  {project && <FeaturedProject featured={home.featured} project={project} />}
  <PlanAProject plan={home.plan} />
  <Crew crew={home.crew} members={content.crewMembers} />
  {review && <Review review={review} />}
  <Faq {...home.faq} items={homeFaqs} id="home" />
  <Cta cta={home.cta} settings={content.settings} />
</Base>
