---
import TextLink from './TextLink.astro';
import FaqList from './FaqList.astro';
import type { Faq } from '../lib/content';
interface Props {
  eyebrow?: string; heading: string; headingAccent?: string;
  linkLabel?: string; linkHref?: string; items: Faq[]; id: string; tone?: 'white' | 'paper';
}
const { eyebrow, heading, headingAccent, linkLabel, linkHref = '/faq/', items, id, tone = 'white' } = Astro.props;
---
{items.length > 0 && (
  <section class:list={['section faq', `faq--${tone}`]} id="questions">
    <div class="container faq__inner">
      <div class="faq__intro">
        <div class="stack-20">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h2 class="h-display h-60">{heading}<br /><em>{headingAccent}</em></h2>
        </div>
        {linkLabel && <TextLink href={linkHref} label={linkLabel} />}
      </div>
      <FaqList items={items} id={id} />
    </div>
  </section>
)}
