---
import Variant from './Variant.astro';
interface Props { href: string; label: string; labelShort?: string }
const { href, label, labelShort } = Astro.props;
---
<a class="text-link" href={href}><Variant full={label} short={labelShort} /> <img src="/assets/icon-arrow-bronze.svg" width="16" height="16" alt="" /></a>
