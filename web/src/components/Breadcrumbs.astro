---
interface Props { trail: { label: string; href?: string }[] }
const { trail } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {trail.map((c, i) => (
      <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
